<?xml version="1.0" encoding="UTF-8"?>
<ejb-jar version="2.0"
         xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/ejb-jar_2_0.xsd">
    <enterprise-beans>
        <session>
            <ejb-name>ejb2</ejb-name>
            <home>ejb2.PropagationTesterHome2</home>
            <remote>ejb2.PropagationTester2</remote>
            <ejb-class>ejb2.PropagationTesterBean2</ejb-class>
            <session-type>Stateless</session-type>
            <transaction-type>Container</transaction-type>
        </session>
    </enterprise-beans>
</ejb-jar>
